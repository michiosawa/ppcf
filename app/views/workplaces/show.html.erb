<% content_for :title, "Showing workplace" %>

<div class="container mx-auto">
  <%= render "navbar" %>
  <div class="md:w-2/3 w-full">
    <% if notice.present? %>
      <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
    <% end %>

    <h1 class="font-bold text-4xl">Showing workplace</h1>

    <%= render @workplace %>


      <h2 class="font-bold text-2xl mt-5">Workdays</h2>
      <ul class="list-disc pl-5">
        <% if @groupby_date.any? %>
          <% @groupby_date.each do |date, workdays| %>
            <li class="mb-2">
              <strong><%= date.strftime("%B %d") %>:</strong>
              <ul class="list-disc pl-5">
                <% workdays.each do |workday| %>
                  <li>
                    <%= workday.worker.name %> - Check-in: <%= workday.checkin.strftime("%H:%M") %>, Check-out: <%= workday.checkout&.strftime("%H:%M") || "N/A" %>
                  </li>
                <% end %>
              </ul>
            </li>
          <% end %>
        <% else %>
          <li>No workdays found for this month.</li>
        <% end %>
      </ul>

    <%= link_to "Edit this workplace", edit_workplace_path(@workplace), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
    <%= link_to "Back to workplaces", workplaces_main_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
    <%= button_to "Destroy this workplace", @workplace, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
  </div>
</div>
