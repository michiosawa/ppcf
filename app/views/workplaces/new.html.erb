<% content_for :title, "New workplace" %>

<div class="container mx-auto">
  <%= render "navbar" %>
  <div class="md:w-2/3 w-full">
    <h1 class="font-bold text-4xl">New workplace</h1>

    <%= form_with url: create_workplace_path, model: @workplace, method: :post do |f| %>
      <div class="card m-1 p-3">
      <%= f.label :title, "現場名" %>
      <%= f.text_field :title, :required => true, class: "bg-gray-200" %>
      </div>
      <div class="card m-1 p-3">
      <%= f.label :manager, "監督名" %>
      <%= f.text_field :manager, class: "bg-gray-200" %>
      </div>
      <div class="card m-1 p-3">
      <%= f.label :address, "住所" %>
      <%= f.textarea :address, rows: 4, class: "bg-gray-200" %>
      </div>
      <div class="card m-1 p-3">
      <%= f.submit "作成", class: "bg-blue-500 rounded" %>
      </div>
    <% end %>

    <%= link_to "Back to workplaces", workplaces_main_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  </div>
</div>
