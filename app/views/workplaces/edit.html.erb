<% content_for :title, "Editing workplace" %>

<div class="container mx-auto">
  <%= render "navbar" %>

  <div class="md:w-2/3 w-full">
    <h1 class="font-bold text-4xl">Editing workplace</h1>

    <%= render "form", workplace: @workplace %>

    <%= link_to "Show this workplace", @workplace, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
    <%= link_to "Back to workplaces", workplaces_main_path, class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  </div>
</div>
