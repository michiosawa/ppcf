<% content_for :title, "Showing worker" %>

<div class="container mx-auto">
  <%= render "navbar" %>

  <div class="md:w-2/3 w-full">
    <% if notice.present? %>
      <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
    <% end %>

    <h1 class="font-bold text-4xl">Showing worker </h1>

    <p class="text-xl"><strong>Name:</strong> <%= @worker.name %></p>
    <p class="text-xl"><strong>Company:</strong> <%= Company.find_by(id: @worker.company_id)&.name %></p>
    <p class="text-xl"><strong>Phone:</strong> <%= @worker.tel %></p>

    <div class="w-full sm:w-auto flex flex-col sm:flex-row space-x-2 space-y-2">
      <div><%= link_to "checkin", checkin_path(@worker.access_token), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %></div>
      <div><%= link_to "new workday", workdays_new_path(access_token: @worker.access_token), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %></div>
      <div><%= link_to "edit", edit_worker_path(@worker.access_token), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %></div>
      <div><%= button_to "destroy", @worker.access_token, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %></div>
      <div><%= link_to "show QR", worker_qr_path(@worker.access_token), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %></div>
    </div>
  </div>
</div>
