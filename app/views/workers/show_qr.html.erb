<div class="container mx-auto">
  <div class="card center p-5">
    <% if notice.present? %>
      <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
    <% end %>
    <h1 class="font-bold text-4xl mb-5"><%= @worker.name %></h1>
    <% url = "http://#{@lan_ip}:3000/worker/#{@worker.access_token}" %>
    <% qrcode = RQRCode::QRCode.new(url) %>
    <%= qrcode.as_svg(color: "000", module_size: 8).html_safe %>
    <%= button_to "Regenerate Token", regenerate_token_path(access_token: @worker.access_token), method: :post, class: "btn btn-primary", data: { confirm: "Are you sure? The old token will stop working." } %>
    <%= link_to "Back", workers_main_path, class: "btn btn-secondary" %>
  </div>
</div>
