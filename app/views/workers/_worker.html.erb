<div id="<%= dom_id worker %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= worker.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Company:</strong>
    <%= worker.company_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Tel:</strong>
    <%= worker.tel %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Last:</strong>
    <%= worker.last %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Access token:</strong>
    <%= worker.access_token %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Etc:</strong>
    <%= worker.etc %>
  </div>
</div>
