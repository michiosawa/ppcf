<div id="<%= dom_id workmonth %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Month:</strong>
    <%= workmonth.month %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Workplace:</strong>
    <%= workmonth.workplace_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Entries:</strong>
    <%= workmonth.entries %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Comment:</strong>
    <%= workmonth.comment %>
  </div>
</div>
