<%= form_with(model: workmonth, class: "contents") do |form| %>
  <% if workmonth.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(workmonth.errors.count, "error") %> prohibited this workmonth from being saved:</h2>

      <ul class="list-disc ml-6">
        <% workmonth.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :month %>
    <%= form.number_field :month, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": workmonth.errors[:month].none?, "border-red-400 focus:outline-red-600": workmonth.errors[:month].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :workplace_id %>
    <%= form.text_field :workplace_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": workmonth.errors[:workplace_id].none?, "border-red-400 focus:outline-red-600": workmonth.errors[:workplace_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :entries %>
    <%= form.textarea :entries, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": workmonth.errors[:entries].none?, "border-red-400 focus:outline-red-600": workmonth.errors[:entries].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :comment %>
    <%= form.textarea :comment, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": workmonth.errors[:comment].none?, "border-red-400 focus:outline-red-600": workmonth.errors[:comment].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
