<% content_for :title, "Companies" %>

<div class="container mx-auto">
  <%= render "navbar" %>

  <div class="relative bg-gray-300 border border-dark mt-2">
    <div> <%= link_to "new company", new_company_path, class: "text-5xl font-medium hover:text-white" %> </div>
  </div>

  <div class="container mx-auto">
    <div class="w-full">
      <% if notice.present? %>
        <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
      <% end %>

      <div class="flex justify-between items-center">
        <h1 class="font-bold text-4xl">Companies</h1>
      </div>

      <div id="companies" class="min-w-full divide-y divide-gray-200 space-y-5">
        <% if @companies.any? %>
          <% @companies.each do |company| %>
            <div class=" sm:flex-row items-center pb-5 sm:pb-0">
              <%= link_to company_path(company) do %>
                <%= render company %>
              <% end %>

            </div>
          <% end %>
        <% else %>
          <p class="text-center my-10">No companies found.</p>
        <% end %>
      </div>
    </div>
  </div>

</div>
