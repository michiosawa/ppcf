<%= form_with(model: workday, class: "contents") do |form| %>
  <% if workday.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(workday.errors.count, "error") %> prohibited this workday from being saved:</h2>

      <ul class="list-disc ml-6">
        <% workday.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :worker_id %>
    <%= form.text_field :worker_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": workday.errors[:worker_id].none?, "border-red-400 focus:outline-red-600": workday.errors[:worker_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :workplace_id %>
    <%= form.text_field :workplace_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": workday.errors[:workplace_id].none?, "border-red-400 focus:outline-red-600": workday.errors[:workplace_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :checkin %>
    <%= form.datetime_field :checkin, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": workday.errors[:checkin].none?, "border-red-400 focus:outline-red-600": workday.errors[:checkin].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :checkout %>
    <%= form.datetime_field :checkout, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": workday.errors[:checkout].none?, "border-red-400 focus:outline-red-600": workday.errors[:checkout].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :healthcheck %>
    <%= form.text_field :healthcheck, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": workday.errors[:healthcheck].none?, "border-red-400 focus:outline-red-600": workday.errors[:healthcheck].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :overtime %>
    <%= form.text_field :overtime, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": workday.errors[:overtime].none?, "border-red-400 focus:outline-red-600": workday.errors[:overtime].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :comment %>
    <%= form.textarea :comment, rows: 4, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": workday.errors[:comment].none?, "border-red-400 focus:outline-red-600": workday.errors[:comment].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
