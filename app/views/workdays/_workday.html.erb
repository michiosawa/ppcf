<div id="<%= dom_id workday %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Worker:</strong>
    <%= workday.worker_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Workplace:</strong>
    <%= workday.workplace_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Checkin:</strong>
    <%= workday.checkin %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Checkout:</strong>
    <%= workday.checkout %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Healthcheck:</strong>
    <%= workday.healthcheck %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Overtime:</strong>
    <%= workday.overtime %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Comment:</strong>
    <%= workday.comment %>
  </div>
</div>
